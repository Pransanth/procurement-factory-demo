{
  "permissions": {
    "deny": [
      "Bash(docker *)",
      "Edit(/factory/reviews/**)",
      "Write(/factory/reviews/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": ["./factory/reviews"]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-validate-findings.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "finding-closure-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/subagentstop-write-review.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
